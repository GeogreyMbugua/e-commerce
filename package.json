{
  "name": "next-commerce-community",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api:dev": "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "api:test": "pnpm --filter api test",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "api:migrate": "pnpm --filter api prisma:migrate",
    "api:seed": "pnpm --filter api prisma:seed",
    "api:generate": "pnpm --filter api prisma:generate",
    "api:start:prod": "cd apps/api && npx prisma migrate deploy && node dist/main.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "stripe:listen": "npx @stripe/cli listen --api-key \"$(grep '^STRIPE_SECRET_KEY=' apps/api/.env | cut -d= -f2-)\" --forward-to localhost:3001/api/v1/payments/webhooks/stripe"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@reduxjs/toolkit": "^2.6.1",
    "@sanity/image-url": "^2.1.1",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "autoprefixer": "10.4.15",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-sanity": "^12.1.1",
    "nodemailer": "^7.0.10",
    "postcss": "8.4.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.4.1",
    "react-range-slider-input": "^3.0.7",
    "react-redux": "^9.2.0",
    "sanity": "^5.16.0",
    "swiper": "^10.2.0",
    "tailwindcss": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.2.3",
    "typescript": "5.2.2"
  }
}
